# Supabase: copy this file to `.env.local` and fill in your project values.
# Find these in the Supabase dashboard: Project Settings > API keys.
# Use the "publishable" key (sb_publishable_...) for a browser app.
# NEVER use the secret key (sb_secret_...) here; it bypasses Row Level Security.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

DEV_ADMIN_USERNAME=developer
DEV_ADMIN_PASSWORD_HASH=scrypt:32768:8:1:salt:hash
ADMIN_SESSION_SECRET=
SUPABASE_SECRET_KEY=
